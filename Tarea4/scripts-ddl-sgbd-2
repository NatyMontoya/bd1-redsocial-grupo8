CREATE TABLE estudiante (
 id_estudiante INTEGER GENERATED ALWAYS AS IDENTITY,
 documento VARCHAR(20) NOT NULL, nombres VARCHAR(100) NOT NULL,
 apellidos VARCHAR(100) NOT NULL, correo VARCHAR(150) NOT NULL,
 contrasena_hash VARCHAR(255) NOT NULL, programa_academico VARCHAR(120) NOT NULL,
 semestre INTEGER NOT NULL CHECK (semestre > 0),
 fecha_registro DATE NOT NULL DEFAULT CURRENT_DATE,
 estado BOOLEAN NOT NULL DEFAULT TRUE,
 CONSTRAINT pk_estudiante PRIMARY KEY (id_estudiante),
 CONSTRAINT uq_estudiante_documento UNIQUE (documento),
 CONSTRAINT uq_estudiante_correo UNIQUE (correo)
);
CREATE TABLE perfil (
 id_perfil INTEGER GENERATED ALWAYS AS IDENTITY,
 id_estudiante INTEGER NOT NULL, biografia TEXT, foto_perfil VARCHAR(500),
 ciudad VARCHAR(100), fecha_nacimiento DATE,
 disponibilidad_mentoria BOOLEAN NOT NULL DEFAULT FALSE,
 CONSTRAINT pk_perfil PRIMARY KEY (id_perfil),
 CONSTRAINT uq_perfil_estudiante UNIQUE (id_estudiante),
 CONSTRAINT fk_perfil_estudiante FOREIGN KEY (id_estudiante)
 REFERENCES estudiante(id_estudiante) ON DELETE CASCADE ON UPDATE CASCADE,
 CONSTRAINT chk_perfil_fecha_nacimiento CHECK (fecha_nacimiento IS NULL OR fecha_nacimiento <= CURRENT_DATE)
);
CREATE TABLE publicacion (
 id_publicacion INTEGER GENERATED ALWAYS AS IDENTITY,
 id_estudiante INTEGER NOT NULL, contenido TEXT NOT NULL,
 tipo_publicacion VARCHAR(30) NOT NULL DEFAULT 'TEXTO',
 fecha_publicacion TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
 estado BOOLEAN NOT NULL DEFAULT TRUE,
 CONSTRAINT pk_publicacion PRIMARY KEY (id_publicacion),
 CONSTRAINT chk_publicacion_tipo CHECK (tipo_publicacion IN ('TEXTO','IMAGEN','ENLACE')),
 CONSTRAINT fk_publicacion_estudiante FOREIGN KEY (id_estudiante)
 REFERENCES estudiante(id_estudiante) ON DELETE CASCADE ON UPDATE CASCADE,
 CONSTRAINT chk_publicacion_contenido CHECK (LENGTH(TRIM(contenido)) > 0)
);
CREATE TABLE comentario (
 id_comentario INTEGER GENERATED ALWAYS AS IDENTITY,
 id_publicacion INTEGER NOT NULL, id_estudiante INTEGER NOT NULL,
 contenido VARCHAR(1000) NOT NULL,
 fecha_comentario TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
 CONSTRAINT pk_comentario PRIMARY KEY (id_comentario),
 CONSTRAINT fk_comentario_publicacion FOREIGN KEY (id_publicacion)
 REFERENCES publicacion(id_publicacion) ON DELETE CASCADE ON UPDATE CASCADE,
 CONSTRAINT fk_comentario_estudiante FOREIGN KEY (id_estudiante)
 REFERENCES estudiante(id_estudiante) ON DELETE CASCADE ON UPDATE CASCADE,
 CONSTRAINT chk_comentario_contenido CHECK (LENGTH(TRIM(contenido)) > 0)
);
